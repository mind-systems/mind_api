POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
HOST_DB_PORT=
CONTAINER_DB_PORT=5432

NODE_ENV=development
TZ=UTC
HOST_API_PORT=3001
CONTAINER_API_PORT=3001

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Resend
RESEND_API_KEY=

LOG_LEVEL=error

# Mail
APP_BASE_URL=
MAIL_FROM=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
WEB_REDIRECT_URI=

# CORS
FRONTEND_URL=

# WebSocket
WS_RECONNECT_GRACE_MS=30000
WS_MIN_SESSION_DURATION_S=10
WS_STREAM_MAX_BUFFER_BYTES=204800
WS_STREAM_MAX_SESSIONS=1000
WS_TELEMETRY_MAX_PAYLOAD_BYTES=65536
WS_BACKPRESSURE_SAMPLES_PER_SEC=50

# gRPC
GRPC_URL=0.0.0.0:50052
HOST_GRPC_PORT=50052
CONTAINER_GRPC_PORT=50052
GRPC_KEEPALIVE_TIME_MS=30000
GRPC_KEEPALIVE_TIMEOUT_MS=10000
GRPC_KEEPALIVE_PERMIT_WITHOUT_CALLS=1
